# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only, NEVER NEXT_PUBLIC
# Opt-in for local /api/lead writes. Leave BLANK. Only set to `true` when
# NEXT_PUBLIC_SUPABASE_URL points at a non-production Supabase project —
# otherwise local form testing writes real rows to the TCPA consent ledger.
ALLOW_LOCAL_LEAD_WRITES=

# ---- Storyblok ----
STORYBLOK_TOKEN=                # server-only preview/public token
STORYBLOK_WEBHOOK_SECRET=       # for /api/revalidate

# ---- Klaviyo (marketing list — newsletter signups only) ----
KLAVIYO_API_KEY=                # server-only

# ---- Resend (team email for contact / wholesale / phenos inquiries) ----
RESEND_API_KEY=                 # server-only; from resend.com
LEAD_NOTIFY_EMAIL=              # where inquiries are sent, e.g. hello@jungleboys.com
RESEND_FROM=                    # verified sender, e.g. "Jungle Boys Website <notifications@jungleboys.com>"

# ---- Revalidation ----
REVALIDATE_SECRET=              # shared secret for webhook -> /api/revalidate

# ---- Dutchie Plus (PHASE 3) ----
# ONE shared GraphQL endpoint for all stores (confirmed by Dutchie,
# 2026-08-07); the store is identified by the API key in the Authorization
# header — one PLUS key per store, no retailer id needed on requests.
# All server-only. Avanti enters real values herself (Vercel env + .env.local).
DUTCHIE_PLUS_ENDPOINT=https://plus.dutchie.com/plus/2021-07/graphql
# 'graphql' switches the site onto the live API (only after keys verify);
# anything else keeps the placeholder catalogue.
DUTCHIE_PLUS_PROVIDER=
DUTCHIE_PLUS_KEY_DOWNTOWN_LOS_ANGELES=
DUTCHIE_PLUS_KEY_ORANGE_COUNTY=
DUTCHIE_PLUS_KEY_POMONA=
DUTCHIE_PLUS_KEY_SAN_DIEGO=
# Sandbox (requested from Dutchie, pending): same shape, sandbox key(s)
DUTCHIE_PLUS_SANDBOX_ENDPOINT=
DUTCHIE_PLUS_SANDBOX_KEY=

# ---- Google Analytics 4 (public by nature — ships in every visitor's HTML) ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=  # G-… ; components/analytics.tsx falls back to the JB property

# ---- Figma (design-time only, read access) ----
FIGMA_TOKEN=                    # personal access token, read-only; server/build-side only
